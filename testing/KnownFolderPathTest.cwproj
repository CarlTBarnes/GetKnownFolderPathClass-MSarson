  <PropertyGroup>
    <ProjectGuid>{C27E9389-2951-43E1-88CB-363B55666F3D}</ProjectGuid>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">Win32</Platform>
    <OutputType>WinExe</OutputType>
    <RootNamespace>KnownFolderPathTest</RootNamespace>
    <AssemblyName>KnownFolderPathTest</AssemblyName>
    <OutputName>KnownFolderPathTest</OutputName>
